#!/bin/sh

max_size=5242880 # 5 MiB
staged_files=$(git diff --cached --name-only --diff-filter=AM)

echo "Checking build artifacts..."

if printf '%s\n' "$staged_files" |
    grep -E '(^|/)(build[^/]*|cmake-build[^/]*|vcpkg_installed|Debug|Release|RelWithDebInfo|MinSizeRel)(/|$)'; then
    echo "Commit rejected: build artifacts are staged."
    exit 1
fi

echo "Checking large files..."

large_file_found=0

for file in $staged_files; do
    blob=$(git rev-parse ":$file" 2>/dev/null) || continue
    size=$(git cat-file -s "$blob")

    if [ "$size" -gt "$max_size" ]; then
        echo "Commit rejected: '$file' exceeds 5 MiB."
        large_file_found=1
    fi
done

if [ "$large_file_found" -ne 0 ]; then
    exit 1
fi

echo "Pre-commit checks passed."
