@startuml
title Minimum bounding box - components
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false

component "Minimum_bounding_box\nExecutable" as app

package "mbb_core (static library)" {
    component "Bounding box approximation\nmbb.cpp / mbb.h" as algorithm
    component "Convex hull\nconvhull_3d.h" as hull
    component "Diameter approximation\nlibgdiam-1.0.3" as diameter

    algorithm ..> hull : computes convex hull
    algorithm ..> diameter : estimates point-set diameter
}

package "Graphics dependencies" {
    component "GLFW" as glfw
    component "GLEW" as glew
    component "GLM" as glm
    component "OpenGL" as opengl
}

app ..> algorithm : calls mbbApproximation()
app ..> glfw : window and input
app ..> glew : OpenGL function loading
app ..> glm : vector and matrix operations
app ..> opengl : rendering

note left of app
    main.cpp: startup and rendering
    utility/: model loading, shaders, camera
end note

@enduml
